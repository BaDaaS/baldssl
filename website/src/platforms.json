{
  "comment": "The platforms baldssl is tested on, and the versions of each. One source for two readers: CI builds the os-rng job matrices from it (scripts/platform-matrix.py), and the website renders its Platforms table from it (vite.config.js). To test a new version, add it here. `expect: link-fail` marks a version below the minimum, where linking must fail: it pins the documented minimum. Every distribution codename comes with its version number.",
  "platforms": [
    {
      "id": "glibc",
      "name": "Linux, glibc",
      "minimum": "glibc 2.25",
      "how": "Built and run inside each distribution, with its own C toolchain.",
      "versions": [
        {
          "name": "Debian 9 (stretch)",
          "libc": "glibc 2.24",
          "image": "buildpack-deps:stretch",
          "expect": "link-fail"
        },
        {
          "name": "Ubuntu 18.04 (bionic)",
          "libc": "glibc 2.27",
          "image": "buildpack-deps:bionic",
          "expect": "pass"
        },
        {
          "name": "Debian 10 (buster)",
          "libc": "glibc 2.28",
          "image": "buildpack-deps:buster",
          "expect": "pass"
        },
        {
          "name": "Ubuntu 20.04 (focal)",
          "libc": "glibc 2.31",
          "image": "buildpack-deps:focal",
          "expect": "pass"
        },
        {
          "name": "Ubuntu 22.04 (jammy)",
          "libc": "glibc 2.35",
          "image": "buildpack-deps:jammy",
          "expect": "pass"
        },
        {
          "name": "Debian 12 (bookworm)",
          "libc": "glibc 2.36",
          "image": "buildpack-deps:bookworm",
          "expect": "pass"
        },
        {
          "name": "Debian 13 (trixie)",
          "libc": "glibc 2.41",
          "image": "buildpack-deps:trixie",
          "expect": "pass"
